import { ComboBox, LineEdit, ListView, ScrollView, Slider, Palette } from "std-widgets.slint";
import { Colors, Body, Hint, Heading, Panel, ActionButton, ToggleRow, NavButton } from "components.slint";

export struct CharacterItem { key: string, display: string, band: string, costume-count: int, selected: bool }
export struct RegionRow { region: string, title: string, motion-index: int, expression-index: int }
export struct AboutLine { label: string, value: string }

export component SettingsWindow inherits Window {
    title: "Bandori 桌宠 LITE - 设置";
    icon: @image-url("../../../assets/icons/bandori.png");
    preferred-width: 1180px;
    preferred-height: 680px;
    min-width: 1080px;
    min-height: 620px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: Colors.canvas;

    in-out property <int> page: 0;
    in property <[CharacterItem]> characters;
    in property <[string]> costume-labels;
    in property <[string]> costume-ids;
    in property <[string]> motion-options;
    in property <[string]> expression-options;
    in property <[RegionRow]> regions;
    in property <[AboutLine]> about-lines;
    in property <[string]> quality-labels: ["省电", "均衡"];
    in property <[string]> theme-labels: ["浅色", "深色", "跟随系统"];
    in property <[string]> preset-labels: ["自动选择", "元气开朗", "傲娇", "害羞内向", "冷静理智", "惊讶意外", "随机"];
    in property <[AboutLine]> active-models;
    in property <image> portrait;
    in property <bool> has-portrait;
    in property <string> active-character-label: "尚未选择角色";
    in property <string> active-costume-label;
    in property <string> active-band;
    in property <bool> has-model;
    in-out property <bool> picking-model: false;
    in-out property <string> search;
    in-out property <string> selected-character;
    in-out property <string> selected-costume;
    in-out property <string> selected-character-label;
    in-out property <string> model-info;
    in-out property <string> status: "正在连接桌宠进程…";
    in-out property <bool> first-run;
    in-out property <int> fps: 120;
    in-out property <float> window-opacity: 100;
    in-out property <int> scale: 100;
    in-out property <int> quality: 1;
    in-out property <bool> vsync: true;
    in-out property <bool> gpu: true;
    in-out property <int> theme: 2;
    in-out property <bool> drag-locked: true;
    in-out property <bool> head-tracking: true;
    in-out property <bool> mutual-gaze: false;
    in-out property <bool> idle-actions: true;
    in-out property <bool> random-actions: true;
    in-out property <bool> emotion: true;
    in-out property <bool> obs: false;
    in-out property <bool> topmost: false;
    in-out property <bool> autostart: false;
    in-out property <bool> hide-model: false;
    in-out property <bool> move-together: false;
    in-out property <int> preset-index: 0;
    in property <int> poke-motion-index;
    in property <int> poke-expression-index;
    in-out property <string> poke-motion;
    in-out property <string> poke-expression;

    callback apply-selection(string, string);
    callback select-character(string);
    callback search-characters(string);
    callback patch-number(string, float);
    callback patch-bool(string, bool);
    callback patch-string(string, string);
    callback apply-preset(string);
    callback edit-region(int, string, string);
    callback reset-positions();
    callback open-folder();

    init => { Palette.color-scheme = root.theme == 0 ? ColorScheme.light : (root.theme == 1 ? ColorScheme.dark : ColorScheme.unknown); }
    changed theme => { Palette.color-scheme = root.theme == 0 ? ColorScheme.light : (root.theme == 1 ? ColorScheme.dark : ColorScheme.unknown); }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 210px;
            background: Colors.sidebar;
            VerticalLayout {
                padding: 10px;
                padding-top: 14px;
                spacing: 8px;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-bottom: 8px;
                    spacing: 7px;
                    height: 41px;
                    Image { source: @image-url("../../../assets/icons/bandori.png"); width: 28px; height: 32px; image-fit: contain; }
                    Heading { text: "导航"; horizontal-stretch: 1; }
                }
                NavButton { text: "角色列表"; icon: @image-url("icons/characters.svg"); tint: #ff568e; active: root.page == 0; clicked => { root.page = 0; } }
                NavButton { text: "角色行为"; icon: @image-url("icons/behavior.svg"); tint: #ff902c; active: root.page == 2; clicked => { root.page = 2; } }
                NavButton { text: "显示设置"; icon: @image-url("icons/display.svg"); tint: #00d976; active: root.page == 1; clicked => { root.page = 1; } }
                NavButton { text: "关于"; icon: @image-url("icons/about.svg"); tint: #a7b0bf; active: root.page == 3; clicked => { root.page = 3; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Hint { text: "BANDORI-PET-LITE"; font-size: 11px; horizontal-alignment: center; }
                Hint { text: "轻量桌宠 · 与你相伴"; font-size: 11px; horizontal-alignment: center; }
                Rectangle { height: 4px; background: transparent; }
            }
        }
        Rectangle { width: 1px; background: Colors.border; }

        VerticalLayout {
            padding-left: 34px;
            padding-right: 28px;
            padding-top: 20px;
            padding-bottom: 14px;
            spacing: 16px;
            if root.first-run : Rectangle {
                height: 36px;
                background: Colors.soft;
                border-radius: 7px;
                Body { x: 12px; width: parent.width - 24px; text: "欢迎使用 Bandori 桌宠，请选择角色与服装；模型文件放入 models 目录。"; font-size: 12px; }
            }

            if root.page == 0 : HorizontalLayout {
                spacing: 32px;
                VerticalLayout {
                    spacing: 16px;
                    Body { text: root.picking-model ? "选择角色 / 服装" : "Live2D 模型详情"; font-size: 28px; font-weight: 700; horizontal-alignment: center; height: 36px; }
                    Body { text: root.picking-model ? "选择已有角色及服装，应用后即可切换。" : "点击切换按钮修改角色 / 服装。"; font-size: 18px; font-weight: 700; horizontal-alignment: center; height: 28px; }

                    if !root.picking-model : HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        portrait-card := Panel {
                            preferred-width: 280px;
                            min-width: 220px;
                            horizontal-stretch: 0.95;
                            background: Colors.card;
                            clip: true;
                            preferred-height: 420px;
                            min-height: 320px;
                            max-height: 420px;
                            VerticalLayout {
                                padding: 20px;
                                padding-top: 16px;
                                spacing: 14px;
                                portrait-frame := Rectangle {
                                    background: transparent;
                                    min-width: 0px;
                                    min-height: 0px;
                                    vertical-stretch: 1;
                                    clip: true;
                                    if root.has-portrait : portrait-image := Image {
                                        x: 0px; y: 0px;
                                        width: parent.width; height: parent.height;
                                        source: root.portrait;
                                        image-fit: contain;
                                    }
                                    if !root.has-portrait : VerticalLayout {
                                        alignment: center;
                                        spacing: 16px;
                                        Image { source: @image-url("icons/characters.svg"); colorize: Colors.accent; height: 80px; image-fit: contain; }
                                        Hint { text: root.has-model ? "此模型未提供角色立绘" : "选择一位角色，开始相伴"; horizontal-alignment: center; }
                                    }
                                }
                                Body { text: root.active-character-label; font-size: 27px; font-weight: 700; horizontal-alignment: center; min-height: 38px; }
                                Body { text: root.has-model ? "服装：" + root.active-costume-label : "还没有正在使用的模型"; font-size: 17px; font-weight: 600; wrap: word-wrap; horizontal-alignment: center; }
                                Body { text: root.active-band == "" ? "" : "乐队：" + root.active-band; font-size: 13px; horizontal-alignment: center; }
                            }
                        }
                        action-card := Panel {
                            preferred-width: 320px;
                            min-width: 245px;
                            horizontal-stretch: 1.05;
                            preferred-height: 420px;
                            min-height: 320px;
                            max-height: 420px;
                            clip: true;
                            ScrollView {
                                x: 9px; y: 12px; width: parent.width - 18px; height: parent.height - 24px;
                                content-width: self.visible-width;
                                VerticalLayout {
                                    spacing: 13px;
                                    padding: 2px;
                                    Rectangle {
                                        height: 132px;
                                        background: transparent;
                                        Rectangle {
                                            width: 132px; height: 132px;
                                            x: (parent.width - self.width) / 2;
                                            border-radius: 66px;
                                            background: switch-touch.has-hover ? #ff79a3 : Colors.accent;
                                            Body { width: parent.width; height: parent.height; text: "切换\n角色/服装"; color: #ffffff; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                                            switch-touch := TouchArea { mouse-cursor: pointer; clicked => { root.picking-model = true; } }
                                            accessible-role: button;
                                            accessible-label: "切换角色/服装";
                                            accessible-action-default => { root.picking-model = true; }
                                        }
                                    }
                                    Hint { text: "选择新的角色或服装"; horizontal-alignment: center; }
                                    Heading { text: "戳一戳动作"; color: Colors.muted; horizontal-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ComboBox { model: root.motion-options; current-index: root.poke-motion-index; enabled: root.has-model; selected(value) => { root.patch-string("poke_motion", value == "自动匹配" ? "" : (value == "随机动作" ? "__random__" : (value == "不触发" ? "__none__" : value))); } }
                                        ActionButton { text: "默认"; width: 54px; enabled: root.has-model; clicked => { root.patch-string("poke_motion", ""); } }
                                    }
                                    Heading { text: "戳一戳表情"; color: Colors.muted; horizontal-alignment: center; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        ComboBox { model: root.expression-options; current-index: root.poke-expression-index; enabled: root.has-model; selected(value) => { root.patch-string("poke_expression", value == "自动匹配" ? "" : (value == "随机动作" ? "__random__" : (value == "不触发" ? "__none__" : value))); } }
                                        ActionButton { text: "默认"; width: 54px; enabled: root.has-model; clicked => { root.patch-string("poke_expression", ""); } }
                                    }
                                    Heading { text: "点击动作反馈"; color: Colors.muted; horizontal-alignment: center; }
                                    Hint { text: "为七个点击区域分别设置动作与表情，自动匹配会按区域选择合适反馈。"; horizontal-alignment: center; }
                                    ActionButton { text: "配置点击动作反馈 →"; clicked => { root.page = 2; } }
                                    Hint { text: root.model-info; font-size: 11px; horizontal-alignment: center; }
                                }
                            }
                        }
                    }

                    if root.picking-model : Panel {
                        VerticalLayout {
                            padding: 15px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                ActionButton { text: "‹ 返回详情"; clicked => { root.picking-model = false; } }
                                LineEdit { text <=> root.search; placeholder-text: "搜索角色 / 乐队"; edited(value) => { root.search-characters(value); } horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    Heading { text: "角色"; }
                                    ListView {
                                        content-width: self.visible-width;
                                        for character in root.characters : Rectangle {
                                            height: 59px; border-radius: 8px;
                                            background: root.selected-character == character.key ? Colors.soft : (character-touch.has-hover ? Colors.hover : transparent);
                                            VerticalLayout {
                                                padding: 9px; spacing: 4px;
                                                Body { text: character.display; font-weight: 600; }
                                                Hint { text: character.band + " · " + character.costume-count + " 套服装"; font-size: 11px; }
                                            }
                                            character-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-character(character.key); } }
                                            accessible-role: button;
                                            accessible-label: character.display;
                                            accessible-action-default => { root.select-character(character.key); }
                                        }
                                    }
                                    if root.characters.length == 0 : Hint { text: "未找到角色，请检查模型目录或搜索条件。"; }
                                }
                                Rectangle { width: 1px; background: Colors.border; }
                                VerticalLayout {
                                    Heading { text: root.selected-character-label == "" ? "服装" : root.selected-character-label + " · 服装"; }
                                    ListView {
                                        content-width: self.visible-width;
                                        for label[index] in root.costume-labels : Rectangle {
                                            height: 44px; border-radius: 7px;
                                            background: root.selected-costume == root.costume-ids[index] ? Colors.soft : (costume-touch.has-hover ? Colors.hover : transparent);
                                            Body { x: 10px; width: parent.width - 20px; text: label; font-size: 12px; }
                                            costume-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected-costume = root.costume-ids[index]; } }
                                            accessible-role: button;
                                            accessible-label: label;
                                            accessible-action-default => { root.selected-costume = root.costume-ids[index]; }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton { text: "✓  应用并切换"; primary: true; enabled: root.selected-character != "" && root.selected-costume != ""; clicked => { root.apply-selection(root.selected-character, root.selected-costume); } }
                                ActionButton { text: "打开模型目录"; clicked => { root.open-folder(); } }
                            }
                        }
                    }
                    Rectangle { background: transparent; vertical-stretch: 1; }
                }

                Panel {
                    width: 260px;
                    ScrollView {
                        x: 15px; y: 16px; width: parent.width - 30px; height: parent.height - 32px;
                        content-width: self.visible-width;
                        VerticalLayout {
                            spacing: 10px;
                            Heading { text: "设置"; }
                            ToggleRow { text: "游戏置顶兼容"; checked: root.topmost; toggled(value) => { root.patch-bool("game_topmost", value); } }
                            ToggleRow { text: "OBS 游戏采集兼容"; checked: root.obs; toggled(value) => { root.patch-bool("obs_window_capture_compatible", value); } }
                            ToggleRow { text: "隐藏 Live2D 形象"; checked: root.hide-model; toggled(value) => { root.patch-bool("hide_live2d_model", value); } }
                            ToggleRow { text: "开机自启动"; checked: root.autostart; toggled(value) => { root.patch-bool("auto_start", value); } }
                            HorizontalLayout {
                                spacing: 12px;
                                Body { text: "主题"; }
                                ComboBox { min-width: 120px; model: root.theme-labels; current-index: root.theme; selected(value) => { root.theme = value == "浅色" ? 0 : (value == "深色" ? 1 : 2); root.patch-string("dark_theme", root.theme == 0 ? "off" : (root.theme == 1 ? "on" : "system")); } }
                            }
                            Hint { text: "设置修改后自动保存并应用"; font-size: 11px; }
                            Rectangle { height: 8px; background: transparent; }
                            Heading { text: "Live2D 模型列表"; }
                            for item in root.active-models : Rectangle {
                                height: 53px; border-radius: 9px; background: Colors.soft;
                                VerticalLayout {
                                    padding: 9px; spacing: 4px;
                                    Body { text: item.label; }
                                    Hint { text: item.value; font-size: 11px; }
                                }
                            }
                            if root.active-models.length == 0 : Hint { text: "暂无模型，点击下方按钮选择角色。"; }
                            ActionButton { text: "+  选择 Live2D 模型"; clicked => { root.picking-model = true; } }
                            ActionButton { text: "打开模型目录"; clicked => { root.open-folder(); } }
                        }
                    }
                }
            }

            if root.page == 1 : VerticalLayout {
                spacing: 18px;
                Body { text: "显示设置"; font-size: 28px; font-weight: 700; height: 40px; }
                Hint { text: "调整桌宠的画面、大小与渲染表现。"; }
                ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 16px;
                        Panel {
                            height: display-layout.min-height;
                            display-layout := VerticalLayout {
                                padding: 22px; spacing: 18px;
                                Heading { text: "画面与性能"; }
                                HorizontalLayout {
                                    spacing: 20px;
                                    Body { text: "画质档位"; width: 110px; }
                                    ComboBox { model: root.quality-labels; current-index: root.quality; width: 160px; selected(value) => { root.patch-string("live2d_quality", value == "均衡" ? "balanced" : "performance"); } }
                                    Hint { text: "省电：0.75× 分辨率    均衡：原生分辨率"; horizontal-stretch: 1; }
                                }
                                HorizontalLayout {
                                    spacing: 20px;
                                    Body { text: "刷新率"; width: 110px; }
                                    Slider { minimum: 30; maximum: 240; step: 10; value: root.fps; changed(value) => { root.fps = round(value); root.patch-number("fps", round(value)); } }
                                    Body { text: root.fps + " FPS"; width: 75px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    spacing: 20px;
                                    Body { text: "模型缩放"; width: 110px; }
                                    Slider { minimum: 25; maximum: 500; step: 5; value: root.scale; changed(value) => { root.scale = round(value); root.patch-number("live2d_scale", round(value)); } }
                                    Body { text: root.scale + " %"; width: 75px; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    spacing: 20px;
                                    Body { text: "不透明度"; width: 110px; }
                                    Slider { minimum: 20; maximum: 100; step: 5; value: root.window-opacity; changed(value) => { root.window-opacity = value; root.patch-number("opacity", value / 100); } }
                                    Body { text: round(root.window-opacity) + " %"; width: 75px; horizontal-alignment: right; }
                                }
                                ToggleRow { text: "垂直同步"; hint: "重启程序后生效"; checked: root.vsync; toggled(value) => { root.patch-bool("vsync", value); } }
                                ToggleRow { text: "GPU 加速"; hint: "重启程序后生效"; checked: root.gpu; toggled(value) => { root.patch-bool("gpu_acceleration", value); } }
                            }
                        }
                        Panel {
                            height: position-layout.min-height;
                            position-layout := VerticalLayout {
                                padding: 22px; spacing: 15px;
                                Heading { text: "桌面位置"; }
                                ToggleRow { text: "一起拖动所有角色"; checked: root.move-together; toggled(value) => { root.patch-bool("move_all_roles_together", value); } }
                                ActionButton { text: "重置所有角色位置"; width: 190px; clicked => { root.reset-positions(); } }
                            }
                        }
                    }
                }
            }

            if root.page == 2 : VerticalLayout {
                spacing: 18px;
                Body { text: "角色行为"; font-size: 28px; font-weight: 700; height: 40px; }
                Hint { text: "设置角色如何回应你，以及点击各个区域时的反馈。"; }
                ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 16px;
                        Panel {
                            height: behavior-layout.min-height;
                            behavior-layout := VerticalLayout {
                                padding: 22px; spacing: 10px;
                                Heading { text: "交互与陪伴"; }
                                ToggleRow { text: "拖拽锁定"; hint: "开启后无法拖动桌宠"; checked: root.drag-locked; toggled(value) => { root.patch-bool("drag_locked", value); } }
                                ToggleRow { text: "看向鼠标"; checked: root.head-tracking; toggled(value) => { root.patch-bool("live2d_head_tracking_enabled", value); } }
                                ToggleRow { text: "角色对视"; checked: root.mutual-gaze; toggled(value) => { root.patch-bool("live2d_mutual_gaze_enabled", value); } }
                                ToggleRow { text: "角色待机动作"; checked: root.idle-actions; toggled(value) => { root.patch-bool("live2d_idle_actions_enabled", value); } }
                                ToggleRow { text: "启用随机动作"; checked: root.random-actions; toggled(value) => { root.patch-bool("live2d_random_actions_enabled", value); } }
                                ToggleRow { text: "本地情绪位移"; checked: root.emotion; toggled(value) => { root.patch-bool("emotion_behavior_enabled", value); } }
                            }
                        }
                        Panel {
                            height: click-layout.min-height;
                            click-layout := VerticalLayout {
                                padding: 22px; spacing: 14px;
                                Heading { text: "点击动作反馈"; }
                                Hint { text: "留在自动匹配时，会按点击位置选择合适反馈。动作和表情可分别设置。"; }
                                HorizontalLayout {
                                    spacing: 14px;
                                    Body { text: "内置预设"; width: 130px; }
                                    ComboBox { model: root.preset-labels; current-index <=> root.preset-index; }
                                    ActionButton { text: "套用预设"; width: 110px; enabled: root.has-model; clicked => { root.apply-preset(root.preset-index == 0 ? "auto" : (root.preset-index == 1 ? "genki" : (root.preset-index == 2 ? "tsundere" : (root.preset-index == 3 ? "shy" : (root.preset-index == 4 ? "cool" : (root.preset-index == 5 ? "surprised" : "random")))))); } }
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    Hint { text: "点击区域"; width: 130px; }
                                    Hint { text: "动作"; horizontal-stretch: 1; }
                                    Hint { text: "表情"; horizontal-stretch: 1; }
                                }
                                for row[index] in root.regions : HorizontalLayout {
                                    spacing: 14px;
                                    Body { text: row.title; width: 130px; }
                                    ComboBox { model: root.motion-options; current-index: row.motion-index; enabled: root.has-model; selected(value) => { root.edit-region(index, "motion", value); } }
                                    ComboBox { model: root.expression-options; current-index: row.expression-index; enabled: root.has-model; selected(value) => { root.edit-region(index, "expression", value); } }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 3 : VerticalLayout {
                spacing: 18px;
                Body { text: "关于"; font-size: 28px; font-weight: 700; height: 40px; }
                Hint { text: "BANDORI-PET-LITE · 轻量的 Bandori 桌面陪伴"; }
                ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 16px;
                        Panel {
                            height: about-layout.min-height;
                            about-layout := VerticalLayout {
                                padding: 24px; spacing: 20px;
                                HorizontalLayout {
                                    spacing: 14px;
                                    Image { source: @image-url("../../../assets/icons/bandori.png"); width: 48px; height: 52px; }
                                    Body { text: "BANDORI-PET-LITE"; font-size: 23px; font-weight: 700; horizontal-stretch: 1; }
                                }
                                for line in root.about-lines : HorizontalLayout {
                                    spacing: 20px;
                                    Hint { text: line.label; width: 90px; }
                                    Body { text: line.value; wrap: word-wrap; horizontal-stretch: 1; font-size: 13px; }
                                }
                                ActionButton { text: "打开模型目录"; width: 160px; clicked => { root.open-folder(); } }
                                Hint { text: "Live2D 运行时：Neocari（GPL-3.0-only）。模型与角色素材版权归 Craft Egg / Bushiroad 所有。"; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            Hint { text: root.status; font-size: 11px; height: 16px; }
        }
    }
}

export struct RadialItem {
    action: string,
    label: string,
    glyph: string,
    angle: float,
}

export component RadialMenu inherits Window {
    title: "BANDORI-PET-LITE 菜单";
    preferred-width: 360px;
    preferred-height: 360px;
    background: #1b1b22;

    in-out property <[RadialItem]> items;
    in-out property <bool> locked: true;

    callback action(string);
    callback locked-toggled(bool);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #1b1b22;
        border-radius: 18px;

        // Four items on a 110 px radius circle starting at 12 o'clock.
        for item[index] in root.items : Rectangle {
            width: 88px;
            height: 88px;
            border-radius: 44px;
            x: parent.width / 2 - self.width / 2 + (index == 0 ? 0px : (index == 1 ? 110px : (index == 2 ? 0px : -110px)));
            y: parent.height / 2 - self.height / 2 + (index == 0 ? -110px : (index == 1 ? 0px : (index == 2 ? 110px : 0px)));
            background: item-touch.has-hover ? #33333d : #26262f;
            border-width: 1px;
            border-color: #3c3c48;

            VerticalLayout {
                spacing: 2px;
                padding-top: 12px;
                Text {
                    text: item.glyph;
                    font-size: 22px;
                    horizontal-alignment: center;
                    color: #ffffff;
                }
                Text {
                    text: item.label;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: #ffffff;
                }
            }
            item-touch := TouchArea {
                clicked => { root.action(item.action); }
            }
        }

        // Center hub: click to toggle the drag lock.
        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            x: parent.width / 2 - self.width / 2;
            y: parent.height / 2 - self.height / 2;
            background: hub-touch.has-hover ? #454550 : #33333c;
            border-width: 2px;
            border-color: #55555f;
            Text {
                text: root.locked ? "🔒" : "🔓";
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #ffffff;
            }
            hub-touch := TouchArea {
                clicked => { root.locked-toggled(!root.locked); }
            }
        }
    }
}


export component PokeBubble inherits Window {
    title: "bandori-pet-bubble";
    preferred-width: 220px;
    preferred-height: 56px;
    background: transparent;

    in-out property <string> text: "戳了你一下";

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 16px;
        background: #e4004f;
        border-width: 1px;
        border-color: #ffffffcc;
        Text {
            text: root.text;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
