import { LineEdit, ListView } from "std-widgets.slint";
import {
    Colors,
    Motion,
    AnimatedContent,
    Body,
    Hint,
    ActionButton,
    SelectField,
} from "components.slint";
import { Texts } from "texts.slint";

export struct PickerCard {
    key: string,
    display: string,
    count-label: string,
    picture: image,
    has-picture: bool,
    favorite: bool
}
export struct PickerRow {cards: [PickerCard]}
export struct CostumeItem { id: string, display: string, favorite: bool }

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> checked;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.pressed || checked ? Colors.soft : (touch.has-hover ? Colors.hover : Colors.card);
    border-width: 1px;
    border-color: checked || focus.has-focus ? Colors.accent : (Colors.dark ? #4a4a4a : #d9dde7);
    animate background, border-color {
        duration: Motion.feedback;
        easing: ease-out;
    }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Image {
        x: touch.pressed ? 6px : 5px;
        y: touch.pressed ? 6px : 5px;
        width: touch.pressed ? 16px : 18px;
        height: self.width;
        source: root.icon;
        colorize: root.checked ? Colors.accent : Colors.muted;
        image-fit: contain;
        animate x, y, width, colorize {
            duration: Motion.feedback;
            easing: ease-out;
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component ModelPicker inherits Rectangle {
    in property <int> stage;
    in property <Texts> t;
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> filter-labels;
    in property <[PickerRow]> rows;
    in property <[CostumeItem]> costumes;
    in property <string> band-label;
    in property <string> character-label;
    in property <string> selected-costume;
    in property <string> preview-costume;
    in-out property <string> search;
    in-out property <string> costume-search;
    in-out property <int> character-filter;
    in-out property <int> costume-filter;
    in property <bool> showing-characters;
    callback back();
    callback choose-card(string);
    callback choose-costume(string);
    callback favorite-character(string);
    callback favorite-costume(string);
    callback preview(string);
    callback hover-preview(string, bool);
    callback refresh();
    callback import-model();
    background: transparent;

    VerticalLayout {
        spacing: 12px;
        picker-heading := Rectangle {
            height: 38px;
            background: transparent;
            picker-title := Body {
                x: root.stage == 2 ? 90px : 0px;
                y: 0px;
                width: parent.width - self.x;
                height: parent.height;
                text: root.title;
                horizontal-alignment: center;
                font-size: 28px;
                font-weight: 700;
            }

            if root.stage != 0: ActionButton {
                x: 0px;
                y: 3px;
                width: root.stage == 2 ? 78px : 106px;
                height: 32px;
                text: root.stage == 2 ? root.t.picker-back : root.t.picker-back-band;
                clicked => { root.back(); }
            }
        }

        Body {
            height: 28px;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: root.stage == 2 ? left : center;
            text: root.subtitle;
        }

        if root.stage == 2: Body {
            height: 20px;
            text: root.t.picker-preview-hint;
            font-size: 14px;
        }
        HorizontalLayout {
            height: 36px;
            spacing: 8px;
            if root.stage != 2: LineEdit {
                text <=> root.search;
                placeholder-text: root.t.picker-search-placeholder;
                horizontal-stretch: 1;
                edited => { root.refresh(); }
            }
            if root.stage == 2: LineEdit {
                text <=> root.costume-search;
                placeholder-text: root.t.picker-costume-search-placeholder;
                horizontal-stretch: 1;
                edited => { root.refresh(); }
            }
            SelectField {
                width: 140px;
                model: root.filter-labels;
                current-index: root.stage == 2 ? root.costume-filter : root.character-filter;
                selected(choice) => {
                    if root.stage == 2 { root.costume-filter = choice; }
                    else { root.character-filter = choice; }
                    root.refresh();
                }
            }

            if root.stage != 2: ActionButton {
                width: 148px;
                text: root.t.picker-import-model-button;
                clicked => { root.import-model(); }
            }
        }

        if root.stage != 2: AnimatedContent {
            revision: root.stage;
            card-list := ListView {
                content-width: max(self.visible-width, root.showing-characters ? 684px : 608px);
                for row in root.rows: Rectangle {
                    height: root.showing-characters ? 374px : 132px;
                    background: transparent;
                    for card[col] in row.cards: Rectangle {
                        x: root.showing-characters ? col * 234px : 22px + col * (parent.width - 224px) / 2;
                        y: card-touch.pressed ? 7px : (card-touch.has-hover ? 3px : 6px);
                        width: root.showing-characters ? 220px : 180px;
                        height: root.showing-characters ? 360px : 120px;
                        border-radius: 5px;
                        background: card-touch.pressed ? Colors.soft : (card-touch.has-hover ? Colors.hover : (Colors.dark ? #272727 : #ffffff));
                        border-width: 1px;
                        border-color: card-focus.has-focus ? Colors.accent : (card-touch.has-hover ? Colors.accent.with-alpha(0.45) : transparent);
                        animate y, background, border-color {
                            duration: Motion.feedback;
                            easing: ease-out;
                        }
                        clip: true;
                        accessible-role: button;
                        accessible-label: card.display;
                        accessible-action-default => { root.choose-card(card.key); }
                        if !root.showing-characters: VerticalLayout {
                            padding: 15px;
                            padding-top: 12px;
                            spacing: 4px;
                            Body {
                                text: card.display;
                                font-weight: 600;
                                height: 22px;
                            }

                            Hint {
                                text: card.count-label;
                                color: Colors.dark ? #999999 : #888888;
                                height: 20px;
                            }

                            Image {
                                source: card.picture;
                                height: 36px;
                                image-fit: contain;
                            }

                            Rectangle {
                                vertical-stretch: 1;
                                background: transparent;
                            }
                        }
                        if root.showing-characters: VerticalLayout {
                            padding: 16px;
                            padding-top: 20px;
                            padding-bottom: 12px;
                            spacing: 8px;
                            Rectangle {
                                height: 264px;
                                background: transparent;
                                clip: true;
                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: card.picture;
                                    image-fit: contain;
                                }

                                if !card.has-picture: Hint {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.t.picker-no-portrait;
                                    horizontal-alignment: center;
                                }
                            }

                            Body {
                                text: card.display;
                                font-weight: 700;
                                height: 24px;
                            }

                            Hint {
                                text: card.count-label;
                                color: Colors.dark ? #999999 : #888888;
                                height: 22px;
                            }
                        }
                        card-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == " " || event.text == "\n" { root.choose-card(card.key); return accept; }
                                return reject;
                            }
                        }

                        card-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { card-focus.focus(); root.choose-card(card.key); }
                        }

                        Rectangle {
                            x: parent.width - 25px;
                            y: 12px;
                            width: 13px;
                            height: 13px;
                            border-radius: 7px;
                            background: #25c76c;
                            border-width: 2px;
                            border-color: #cce9d7;
                        }

                        if root.showing-characters: IconButton {
                            x: parent.width - 36px;
                            y: 34px;
                            icon: @image-url("icons/heart.svg");
                            checked: card.favorite;
                            label: root.t.picker-favorite-character + card.display;
                            clicked => { root.favorite-character(card.key); }
                        }
                    }
                }
            }
        }
        if root.stage != 2 && root.rows.length == 0: Hint {
            text: root.t.picker-no-characters;
            horizontal-alignment: center;
        }
        if root.stage == 2: AnimatedContent {
            costume-list := ListView {
                content-width: self.visible-width;
                for costume in root.costumes: Rectangle {
                    height: 46px;
                    background: transparent;
                    Rectangle {
                        height: 40px;
                        width: parent.width;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.selected-costume == costume.id || costume-focus.has-focus ? Colors.accent : (Colors.dark ? #555555 : #d9dde7);
                        background: root.selected-costume == costume.id || costume-touch.pressed ? Colors.soft : (costume-touch.has-hover ? Colors.hover : (Colors.dark ? #2c2c2c : #ffffff));
                        animate background, border-color {
                            duration: Motion.feedback;
                            easing: ease-out;
                        }
                        Body {
                            x: 16px;
                            width: parent.width - 100px;
                            height: parent.height;
                            text: costume.display;
                        }

                        accessible-role: button;
                        accessible-label: root.t.picker-choose-costume + costume.display;
                        accessible-action-default => { root.choose-costume(costume.id); }
                        costume-focus := FocusScope {
                            key-pressed(event) => {
                                if event.text == " " || event.text == "\n" { root.choose-costume(costume.id); return accept; }
                                return reject;
                            }
                        }

                        costume-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { costume-focus.focus(); root.choose-costume(costume.id); }
                            moved => { root.hover-preview(costume.id, self.has-hover && self.pressed == false); }
                            changed has-hover => { if !self.has-hover { root.hover-preview(costume.id, false); } }
                        }

                        IconButton {
                            x: parent.width - 74px;
                            y: 6px;
                            icon: @image-url("icons/eye.svg");
                            label: root.t.picker-preview-costume + costume.display;
                            checked: root.preview-costume == costume.id;
                            clicked => { root.preview(costume.id); }
                        }

                        IconButton {
                            x: parent.width - 38px;
                            y: 6px;
                            icon: @image-url("icons/heart.svg");
                            label: root.t.picker-favorite-costume + costume.display;
                            checked: costume.favorite;
                            clicked => { root.favorite-costume(costume.id); }
                        }
                    }
                }
            }
        }
        if root.stage == 2 && root.costumes.length == 0: Hint {
            text: root.t.picker-no-costumes;
            horizontal-alignment: center;
        }
    }
}
