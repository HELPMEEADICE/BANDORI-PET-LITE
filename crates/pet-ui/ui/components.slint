import { Palette } from "std-widgets.slint";

export global Colors {
    out property <bool> dark: Palette.background == #1c1c1c;
    out property <color> canvas: dark ? #1f1f1f : #f7f7f9;
    out property <color> sidebar: dark ? #181818 : #ffffff;
    out property <color> panel: dark ? #222022 : #ffffff;
    out property <color> card: dark ? #303030 : #ffffff;
    out property <color> border: dark ? #3c373e : #e4dfe5;
    out property <color> text: dark ? #ffffff : #25232a;
    out property <color> muted: dark ? #a7b0bf : #687385;
    out property <color> accent: dark ? #ff568e : #e4004f;
    out property <color> soft: dark ? #511c32 : #ffe5ee;
    out property <color> hover: dark ? #343036 : #f5edf1;
}

// Shared timings keep feedback quick and page entrances calm. No looping animations.
export global Motion {
    out property <duration> feedback: 120ms;
    out property <duration> selection: 160ms;
    out property <duration> entrance: 220ms;
}

export component AnimatedContent inherits Rectangle {
    in property <int> revision;
    private property <bool> entered: false;
    min-width: 0px;
    min-height: 0px;
    background: transparent;
    opacity: 0;

    changed revision => { root.entered = false; }
    // Start after the first frame, then stop the timer for the rest of this view.
    Timer {
        interval: 16ms;
        running: !root.entered;
        triggered => { root.entered = true; }
    }
    content := Rectangle {
        y: 8px;
        width: root.width;
        height: root.height;
        background: transparent;
        @children
    }
    states [
        shown when root.entered: {
            opacity: 1;
            content.y: 0px;
            in {
                animate opacity, content.y { duration: Motion.entrance; easing: ease-out; }
            }
        }
    ]
}

export component Body inherits Text {
    color: Colors.text;
    font-size: 14px;
    vertical-alignment: center;
    overflow: elide;
}

export component Hint inherits Body {
    color: Colors.muted;
    font-size: 13px;
    wrap: word-wrap;
}

export component Heading inherits Body {
    font-size: 15px;
    font-weight: 700;
}

export component Panel inherits Rectangle {
    background: Colors.panel;
    border-color: Colors.border;
    border-width: 1px;
    border-radius: 16px;
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <color> text-color: primary ? #201018 : Colors.text;
    callback clicked();
    min-height: 34px;
    min-width: 64px;
    vertical-stretch: 0;
    border-radius: 5px;
    background: primary ? (touch.pressed ? #f05c8d : (touch.has-hover ? #ff8ab0 : #ff79a3)) : (touch.pressed ? Colors.soft : (touch.has-hover ? Colors.hover : Colors.card));
    border-width: primary ? 0px : 1px;
    border-color: focus.has-focus ? Colors.accent : Colors.border;
    opacity: enabled ? 1 : 0.45;
    animate background, border-color, opacity { duration: Motion.feedback; easing: ease-out; }
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Body {
        width: parent.width;
        height: parent.height;
        y: touch.pressed && root.enabled ? 1px : 0px;
        text: root.text;
        color: root.text-color;
        horizontal-alignment: center;
        animate y { duration: Motion.feedback; easing: ease-out; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component ToggleRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);
    height: hint == "" ? 34px : 53px;
    border-radius: 6px;
    background: touch.has-hover ? Colors.hover : transparent;
    animate background { duration: Motion.feedback; easing: ease-out; }
    accessible-role: checkbox;
    accessible-label: text;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(!root.checked); }
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            Body { text: root.text; }
            if root.hint != "" : Hint { text: root.hint; font-size: 12px; }
        }
        Rectangle {
            width: 40px;
            height: 21px;
            border-radius: 11px;
            border-width: 1px;
            border-color: focus.has-focus ? Colors.accent : (root.checked ? Colors.accent : #999999);
            background: root.checked ? Colors.accent : transparent;
            animate background, border-color { duration: Motion.selection; easing: ease-out; }
            Rectangle {
                x: root.checked ? 23px : 4px;
                y: 4px;
                width: 13px;
                height: 13px;
                border-radius: 7px;
                background: root.checked ? #ffffff : #cecece;
                animate x, background { duration: Motion.selection; easing: ease-out; }
            }
        }
        Body {
            text: root.checked ? "On" : "Off"; width: 24px; font-size: 13px;
            color: root.checked ? Colors.accent : Colors.muted;
            animate color { duration: Motion.selection; easing: ease-out; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.toggled(!root.checked); }
    }
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <color> tint;
    in property <bool> active;
    callback clicked();
    height: 45px;
    border-radius: 10px;
    background: touch.pressed ? Colors.soft : (active ? Colors.soft : (touch.has-hover ? Colors.hover : Colors.panel));
    border-width: 1px;
    border-color: active || focus.has-focus ? Colors.accent : Colors.border;
    animate background, border-color { duration: Motion.selection; easing: ease-out; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: -4px; y: (parent.height - self.height) / 2;
        width: 4px; height: root.active ? 27px : 8px;
        opacity: root.active ? 1 : 0;
        border-radius: 2px; background: Colors.accent;
        animate height, opacity { duration: Motion.selection; easing: ease-out; }
    }
    Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 29px;
        height: 29px;
        border-radius: 9px;
        background: root.active ? #f00063 : root.tint.with-alpha(0.18);
        animate background { duration: Motion.selection; easing: ease-out; }
        Image {
            x: 5px; y: 5px; width: 19px; height: 19px; source: root.icon; image-fit: contain;
            colorize: root.active ? #ffffff : root.tint;
            animate colorize { duration: Motion.selection; easing: ease-out; }
        }
    }
    Body { x: 49px; width: parent.width - 59px; height: parent.height; text: root.text; font-weight: root.active ? 700 : 400; }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
